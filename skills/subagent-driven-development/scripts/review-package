#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# When the plan's ledger exists, the package ends with its Ruling: lines
# (parked findings carry one) and deferred minors, so a reviewer weighs the
# calls already made from
# the same file instead of being handed the plan (--no-ledger leaves them out;
# scoped re-reviews do not need them).
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE] [--ledger|--no-ledger]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

ledger=1
args=()
for a in "$@"; do
  case "$a" in
    --ledger) ledger=1 ;;
    --no-ledger) ledger=0 ;;
    *) args+=("$a") ;;
  esac
done
if [ "${#args[@]}" -lt 3 ] || [ "${#args[@]}" -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE] [--ledger|--no-ledger]" >&2
  exit 2
fi

plan=${args[0]}
base=${args[1]}
head=${args[2]}
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

# Range guards (exit 3): a wrong-branch HEAD yields a range that is empty or
# not rooted at BASE; either would silently produce a bogus review package.
git merge-base --is-ancestor "$base" "$head" || { echo "HEAD is not a descendant of BASE: ${base}..${head}" >&2; exit 3; }
[ "$(git rev-list --count "${base}..${head}")" -gt 0 ] || { echo "empty commit range: ${base}..${head}" >&2; exit 3; }

# Invoke via bash rather than direct exec: some extractors (Python zipfile)
# strip Unix exec bits when unpacking marketplace packages (#2040).
dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
if [ "${#args[@]}" -eq 4 ]; then
  out=${args[3]}
else
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  # Trailers included, so a reviewer can see a mandated trailer is present.
  git log --format='%h %s%n%(trailers:only,unfold)' "${base}..${head}" \
    | sed '/^$/d; /^[0-9a-f]\{7,\} /!s/^/    /'
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
  if [ "$ledger" -eq 1 ] && [ -f "$dir/progress.md" ]; then
    echo
    echo "## Prior rulings and deferred findings"
    echo
    echo "From the plan's ledger: decisions the controller took, each with what it"
    echo "costs if wrong, and findings deferred or parked so far. Weigh each against"
    echo "the code and grade independently: a ruling is a claim to check, like the"
    echo "implementer's report, never a reason to withhold or downgrade a finding."
    echo
    grep -E 'Ruling:|minor \(deferred\)' "$dir/progress.md" || echo "(none yet)"
  fi
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
