#!/usr/bin/env bash
# Render a subagent's dispatch prompt from its template into a file in the
# plan's workspace and print the path, so the controller's dispatch is one
# line ("Read <path> and follow it") instead of a hand-filled template.
#
# Why: in one week's controller session, 60 hand-written dispatches came to
# 286k characters (4-8k each), all resident in the controller's context for
# the rest of the session; the templates were re-read after compactions to
# refill placeholders; and the plan's Global Constraints were paraphrased per
# task because copying them by hand is expensive. Here every placeholder the
# script can know is filled from the plan, the workspace naming rules and git,
# and the constraints are copied verbatim.
#
# Usage:
#   dispatch implementer PLAN_FILE N            [--note FILE|-]
#   dispatch reviewer    PLAN_FILE N BASE HEAD  [--note FILE|-]
#   dispatch re-review   PLAN_FILE N|final FIX_BASE HEAD --note FILE|-
#   dispatch final       PLAN_FILE MERGE_BASE HEAD [--note FILE|-]
#
# The note is the controller's free text: for the implementer, where the task
# fits, interfaces and rulings from earlier tasks, and its resolution of any
# ambiguity; for the reviewer, constraints from the spec that bind this task
# beyond the plan's Global Constraints; for a re-review, the findings under
# verification (required); for the final review, what was built and the spec
# path. "-" reads it from stdin.
set -euo pipefail

usage() {
  sed -n '/^# Usage:/,/^# path/p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

here="$(cd "$(dirname "$0")" && pwd)"
skill="$(dirname "$here")"

note=""
have_note=0
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --note)
      [ $# -ge 2 ] || usage
      if [ "$2" = - ]; then note=$(cat); else
        [ -f "$2" ] || { echo "no such note file: $2" >&2; exit 2; }
        note=$(cat "$2")
      fi
      have_note=1
      shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
[ "${#args[@]}" -ge 3 ] || usage
role=${args[0]}
plan=${args[1]}
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

# Invoke helpers via bash rather than direct exec: some extractors (Python
# zipfile) strip Unix exec bits when unpacking marketplace packages (#2040).
run() { "${BASH:-bash}" "$here/$1" "${@:2}"; }
wrote() { sed -n 's/^wrote \(.*\): .*$/\1/p' | head -n 1; }

ws=$(run sdd-workspace "$plan")
repo=$(git rev-parse --show-toplevel)
plan_abs="$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")"

# Full SHAs, so a rendered prompt never names a moving ref like HEAD~1.
sha() {
  git rev-parse --verify --quiet "$1^{commit}" || { echo "bad commit: $1" >&2; exit 2; }
}

# The prompt body of a template: the lines under "prompt: |" up to the
# template's closing fence, de-indented.
body_of() {
  awk '
    /^  prompt: \|$/ { on = 1; next }
    on && /^```$/ { exit }
    on { sub(/^    /, ""); print }
  ' "$1"
}

# The plan's Global Constraints section, verbatim, without its heading.
constraints_of() {
  awk '
    /^```/ { infence = !infence }
    !infence && /^#+[ \t]/ {
      level = match($0, /[^#]/) - 1
      if (on && level <= onlevel) exit
      if (!on && tolower($0) ~ /^#+[ \t]+global constraints/) { on = 1; onlevel = level; next }
    }
    on { print }
  ' "$1" | awk 'NF { seen = 1 } seen'
}

short() { git rev-parse --short "$1"; }

case "$role" in
  implementer)
    [ "${#args[@]}" -eq 3 ] || usage
    n=${args[2]}
    brief=$(run task-brief "$plan" "$n" | wrote)
    report="${brief%-brief.md}-report.md"
    name=$(sed -n 's/^#\{1,\}[ \t]*Task[ \t]*'"$n"'[^0-9][: \t]*//p' "$brief" | head -n 1)
    out="$ws/task-${n}-implementer.md"
    body=$(body_of "$skill/implementer-prompt.md")
    body=${body//"Task N: [task name]"/"Task ${n}: ${name}"}
    body=${body//"[BRIEF_FILE]"/"$brief"}
    context=${note:-"(Nothing beyond the brief.)"}
    body=${body//"[Scene-setting: where this fits, dependencies, architectural context]"/"$context"}
    body=${body//"[directory]"/"$repo"}
    body=${body//"[REPORT_FILE]"/"$report"}
    desc="Implement Task ${n}: ${name}"
    ;;
  reviewer)
    [ "${#args[@]}" -eq 5 ] || usage
    n=${args[2]}
    base=$(sha "${args[3]}")
    head=$(sha "${args[4]}")
    brief=$(run task-brief "$plan" "$n" 2>/dev/null | wrote)
    report="${brief%-brief.md}-report.md"
    diff=$(run review-package "$plan" "$base" "$head" | wrote)
    gc=$(constraints_of "$plan")
    [ -n "$gc" ] || gc="(The plan has no Global Constraints section.)"
    if [ "$have_note" -eq 1 ]; then gc="${gc}

From the controller:
${note}"; fi
    out="$ws/task-${n}-review-$(short "$base")..$(short "$head").md"
    body=$(body_of "$skill/task-reviewer-prompt.md")
    body=${body//"[BRIEF_FILE]"/"$brief"}
    body=${body//"[GLOBAL_CONSTRAINTS]"/"$gc"}
    body=${body//"[REPORT_FILE]"/"$report"}
    body=${body//"[BASE_SHA]"/"$base"}
    body=${body//"[HEAD_SHA]"/"$head"}
    body=${body//"[DIFF_FILE]"/"$diff"}
    desc="Review Task ${n} (spec + quality)"
    ;;
  re-review)
    [ "${#args[@]}" -eq 5 ] || usage
    [ "$have_note" -eq 1 ] && [ -n "$note" ] || { echo "re-review needs the findings under verification: --note FILE|-" >&2; exit 2; }
    n=${args[2]}
    base=$(sha "${args[3]}")
    head=$(sha "${args[4]}")
    if [ "$n" = final ]; then
      brief=$(run task-brief "$plan" header | wrote)
      report="$ws/final-fix-report.md"
    else
      brief=$(run task-brief "$plan" "$n" 2>/dev/null | wrote)
      report="${brief%-brief.md}-report.md"
    fi
    diff=$(run review-package "$plan" "$base" "$head" --no-ledger | wrote)
    out="$ws/task-${n}-rereview-$(short "$base")..$(short "$head").md"
    body=$(body_of "$skill/re-review-prompt.md")
    body=${body//"[BRIEF_FILE]"/"$brief"}
    body=${body//"[FINDINGS]"/"$note"}
    body=${body//"[REPORT_FILE]"/"$report"}
    body=${body//"[FIX_BASE_SHA]"/"$base"}
    body=${body//"[HEAD_SHA]"/"$head"}
    body=${body//"[DIFF_FILE]"/"$diff"}
    desc="Re-review Task ${n} fix"
    ;;
  final)
    [ "${#args[@]}" -eq 4 ] || usage
    base=$(sha "${args[2]}")
    head=$(sha "${args[3]}")
    header=$(run task-brief "$plan" header | wrote)
    diff=$(run review-package "$plan" "$base" "$head" | wrote)
    reqs="Read the plan's shared header first: ${header}
It holds the Goal, the Global Constraints, the Review Focus (check each of its
lines deliberately) and any amendments. The full plan is ${plan_abs}: open a
task's text only for a question the diff raises (\`grep -n '^#.*Task' ${plan_abs}\`
finds it) rather than reading the whole file.

Review package: ${diff}"
    out="$ws/final-review-$(short "$base")..$(short "$head").md"
    body=$(body_of "$skill/../requesting-code-review/code-reviewer.md")
    desc_text=${note:-"See the Goal in the plan's shared header."}
    body=${body//"[DESCRIPTION]"/"$desc_text"}
    body=${body//"[PLAN_OR_REQUIREMENTS]"/"$reqs"}
    body=${body//"[BASE_SHA]"/"$base"}
    body=${body//"[HEAD_SHA]"/"$head"}
    desc="Final whole-branch review"
    ;;
  *) usage ;;
esac

[ -n "$body" ] || { echo "template for ${role} has no prompt body" >&2; exit 1; }

# A bracketed upper-case name left in the body is a placeholder nobody filled.
# [SHA] is the reviewer's own placeholder in code-reviewer.md's worktree example.
left=$(printf '%s\n' "$body" | grep -oE '\[[A-Z][A-Z_]{2,}\]' | grep -vx '\[SHA\]' | sort -u || true)
if [ -n "$left" ]; then
  echo "unfilled placeholders in the ${role} dispatch: $(printf '%s' "$left" | tr '\n' ' ')" >&2
  exit 1
fi

printf '%s\n' "$body" > "$out"
echo "wrote ${out}: $(wc -c < "$out" | tr -d ' ') bytes"
echo "description: ${desc}"
echo "prompt: Read ${out} and follow it; it is your complete instructions."
